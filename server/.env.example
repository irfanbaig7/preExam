# ---- Required ----
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pyq_analyzer
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
CLIENT_URL=http://localhost:3000
# Whoever registers with this email becomes admin
ADMIN_EMAIL=admin@pyq.local

# ---- Optional (app works without these) ----
# AI topic tagging + study plans. Empty = built-in keyword fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Redis cache. Empty = in-memory cache
REDIS_URL=
# Email. Empty = emails are printed in the server console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PYQ Analyzer <no-reply@pyq.local>
# Razorpay. Empty = Premium page uses a demo activate button
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PREMIUM_PRICE_INR=99
UPLOAD_DIR=uploads
